<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Partial Info.plist for keys that have no INFOPLIST_KEY_* build-setting
	  equivalent. GENERATE_INFOPLIST_FILE=YES merges Xcode's generated keys
	  (bundle id, usage strings, orientations, etc.) on top of these.
	-->
	<key>UIBackgroundModes</key>
	<array>
		<string>location</string>
	</array>
	<!-- Expose the app's Documents folder in the Files app (On My iPhone). -->
	<key>UIFileSharingEnabled</key>
	<true/>
</dict>
</plist>
